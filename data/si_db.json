  {
   "id": "density",
   "name": "密度",
   "category": "mech",
   "unit": "kg m-3",
   "defined_by": "density_def",
   "description": "単位体積あたりの質量。",
   "how": "密度は「体積あたりの質量」。kg を m³ で割って kg/m³ です。"
  },
  {
