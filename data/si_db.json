   "unit": "N m",
   "defined_by": "torque",
   "description": "物体を回転させようとする働き。回転軸からの距離×力。",
   "how": "トルクは「回転軸からの距離 × 力」。m と N をかけて N·m です。エネルギーの J と同じ形ですが、意味が違うのでトルクには J を使いません。"
  },
  {
   "id": "moment_of_inertia",
   "name": "慣性モーメント",
   "category": "mech",
   "unit": "kg m2",
   "defined_by": "inertia_point",
   "description": "回転させにくさ。回転運動における質量の役割をもつ。",
   "how": "慣性モーメントは、質量に回転軸からの距離の2乗をかけたもの。kg × m² で kg·m² です。"
  },
  {
   "id": "angular_momentum",
   "name": "角運動量",
   "category": "mech",
   "unit": "kg m2 s-1",
   "defined_by": "ang_mom",
   "description": "回転運動の勢い。回転軸からの距離×運動量。",
   "how": "角運動量は「回転軸からの距離 × 運動量」。m に kg·m/s をかけて kg·m²/s です。"
  },
  {
   "id": "spring_constant",
   "name": "ばね定数",
   "category": "mech",
   "unit": "N m-1",
   "defined_by": "hooke",
   "description": "ばねを単位長さ伸ばすのに必要な力。ばねの硬さ。",
   "how": "フックの法則 F = kx を k について解くと k = F/x。N を m で割って N/m、つまり「1 m 伸ばすのに必要な力」です。"
  },
  {
   "id": "surface_tension",
   "name": "表面張力",
   "category": "mech",
   "unit": "N m-1",
   "defined_by": "surface",
   "description": "液体の表面が単位長さあたりに縮もうとする力。",
   "how": "表面張力は、液面のふちの長さあたりに働く力です。N を m で割って N/m になります。"
  },
  {
   "id": "viscosity",
   "name": "粘性係数（粘度）",
   "category": "mech",
   "unit": "Pa s",
   "defined_by": "newton_visc",
   "description": "流体のねばりけ。流れの速さの差に逆らう力の大きさを決める。",
   "how": "粘性の法則 F = ηSv/d を η について解くと η = Fd/(Sv)。単位を当てはめて整理すると、N/m²（= Pa）に s をかけた Pa·s が残ります。"
  },
  {
   "id": "gravitational_constant",
   "name": "万有引力定数",
   "category": "mech",
   "unit": "N m2 kg-2",
   "defined_by": "gravity",
   "description": "2つの質量の間に働く引力の強さを決める定数。",
   "how": "万有引力の法則 F = GMm/r² を G について解くと G = Fr²/(Mm)。N × m² ÷ kg² で N·m²/kg² です。"
  },
  {
   "id": "number_density",
   "name": "数密度",
   "category": "mech",
   "unit": "m-3",
   "defined_by": "n_def",
   "description": "単位体積あたりの粒子の個数。",
   "how": "数密度は「体積あたりの個数」。個数には単位がないので、m³ で割った m⁻³ だけが残ります。"
  },
  {
   "id": "heat_capacity",
   "name": "熱容量",
   "category": "thermo",
   "unit": "J K-1",
   "defined_by": "heat_cap",
   "description": "物体の温度を1 K上げるのに必要な熱量にあたる量。",
   "how": "熱容量は「温度を1 K上げるのに必要な熱量」。J を K で割って J/K です。"
  },
  {
   "id": "specific_heat",
   "name": "比熱（比熱容量）",
   "category": "thermo",
   "unit": "J kg-1 K-1",
   "defined_by": "spec_heat",
   "description": "単位質量あたりの熱容量。物質ごとの温まりにくさ。",
   "how": "比熱は熱容量をさらに質量で割ったもの。Q = mcΔT から c = Q/(mΔT) なので J/(kg·K) です。"
  },
  {
   "id": "latent_heat",
   "name": "潜熱（比潜熱）",
   "category": "thermo",
   "unit": "J kg-1",
   "defined_by": "latent",
   "description": "状態変化（融解・蒸発など）に必要な単位質量あたりの熱量。",
   "how": "潜熱は「1 kg を状態変化させるのに必要な熱」。J を kg で割って J/kg です。"
  },
  {
   "id": "entropy",
   "name": "エントロピー",
   "category": "thermo",
   "unit": "J K-1",
   "defined_by": "entropy",
   "description": "受け取った熱量を温度で割って積み上げた量。乱雑さの尺度。",
   "how": "エントロピーの変化は「受け取った熱 ÷ 温度」。J を K で割って J/K。熱容量と同じ単位になります。"
  },
  {
   "id": "molar_mass",
   "name": "モル質量",
   "category": "thermo",
   "unit": "kg mol-1",
   "defined_by": "molar_mass",
   "description": "物質量あたりの質量。",
   "how": "モル質量は「1 mol あたりの質量」。kg を mol で割って kg/mol です。"
  },
  {
   "id": "gas_constant",
   "name": "気体定数",
   "category": "thermo",
   "unit": "J mol-1 K-1",
   "defined_by": "ideal_gas",
   "description": "理想気体の圧力・体積・物質量・温度を結ぶ定数。",
   "how": "状態方程式 pV = nRT を R について解くと R = pV/(nT)。pV の単位 Pa·m³ は J と同じなので、R は J/(mol·K) になります。"
