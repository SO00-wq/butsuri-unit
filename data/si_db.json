  },
  {
   "id": "momentum",
   "name": "運動量",
   "category": "mech",
   "unit": "kg m s-1",
   "defined_by": "p_def",
   "description": "質量と速度の積。運動の「勢い」を表す。",
   "how": "運動量は質量×速度。kg と m/s をかけて kg·m/s です。"
  },
  {
   "id": "impulse",
   "name": "力積",
   "category": "mech",
   "unit": "N s",
   "defined_by": "impulse_def",
   "description": "力とそれが働いた時間の積。運動量の変化に等しい。",
   "how": "力積は「力 × 力が働いた時間」。N に s をかけて N·s です。基本単位に直すと、運動量と同じ kg·m/s になります。"
  },
  {
